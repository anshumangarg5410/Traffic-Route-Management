# ITMS Security & Authentication Configuration Template
# Copy this file to .env or set variables in your deployment environment.

# Deployment Environment ('development', 'test', 'production')
ENVIRONMENT=development

# JWT Secret Key (REQUIRED in production, minimum 32 characters high entropy)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars-long

# JWT Algorithm (default: HS256)
JWT_ALGORITHM=HS256

# Token Expiration Lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Configuration for Refresh Token Transport
COOKIE_NAME=itms_refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_PATH=/

# Database Configuration (Defaults to backend/data/itms.db)
# DATABASE_URL=sqlite+aiosqlite:///backend/data/itms.db
